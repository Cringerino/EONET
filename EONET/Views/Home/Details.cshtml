@model EONET.Models.Event

@{
	ViewData["Title"] = "Event Details";
}

@if (Model == null)
{
	<p>Event not found.</p>
}
else
{

	<h1 class="mb-4">@Model.title</h1>

	<h5 class="mb-4">Discription:</h5>
	<p>
		@if (Model.description == null)
		{
			<span>
				No description available
			</span>
		}
		else
		{
			<span>
				@Model.description
			</span>
		}
	</p>

	<p class="mb-4">
		Categories:
		@foreach (var categorie in Model.categories)
		{
			<span>@categorie.title </span>
		}
	</p>

	<p class="mb-4">
		Status: 
		@if(Model.closed == null)
		{
			<span>not defined</span>
		}
		else
		{
			<span>@Model.closed</span>
		}
	</p>

	<p>
		source:
		@for (int i = 0; i < Model.sources.Count(); i++)
		{
			<a href="@Model.sources[i].url" style="text-decoration:none;color:inherit;">Link @(i+1) </a>
		}
	</p>
	<br />

	<h5 class="mb-4">Affected Geometries:</h5>
	<table class="table table-striped">
		<tr>
			<th>Value</th>
			<th>Unit</th>
			<th>Date</th>
			<th>Type</th>
			<th>Cordinates</th>
		</tr>
		@foreach (var item in Model.geometry)
		{
			<tr>
				<td>@item.magnitudeValue</td>
				<td>@item.magnitudeUnit</td>
				<td>@item.date</td>
				<td>@item.type</td>
				<td>
					@foreach (var coordinate in item.coordinates)
					{
						<span>@coordinate </span>
					}
				</td>
			</tr>
		}
	</table>
}