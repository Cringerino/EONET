@model List<EONET.Models.EonetData>

@{
	ViewData["Title"] = "Natural Events";
}

<h1 class="mb-4">Natural Events</h1>


@* Table with all fetched events *@
<table class="table table-striped table-hover align-middle">
	<thead>
		<tr>
			<th><a asp-action="Index" asp-route-sortOrder="name" style="text-decoration:none;color:inherit;" target="_blank">Name</a></th>
			<th><a asp-action="Index" asp-route-sortOrder="county" style="text-decoration:none;color:inherit;" target="_blank">County</a></th>
			<th><a asp-action="Index" asp-route-sortOrder="state" style="text-decoration:none;color:inherit;" target="_blank">State</a></th>
			<th>Link</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>@item._name</td>
                <td>@item._county</td>
                <td>@item._state</td>
				<td><a href="@item._link" target="_blank" rel="noreferrer">Details</a></td>
			</tr>
		}
	</tbody>
</table>
