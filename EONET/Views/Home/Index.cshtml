@model List<EONET.Models.EonetData>

@{
	ViewData["Title"] = "Natural Events";
}

<h1 class="mb-4">Natural Events</h1>

<form asp-action="Index" method="get" class="form-inline mb-4">
	<div class="input-group mb-3">
		<input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search...">
		<button type="submit" class="btn btn-outline-secondary">Search</button>
		<button class="btn btn-outline-secondary">
			<a asp-action="Index" style="text-decoration:none;color:inherit;">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-clockwise" viewBox="0 0 16 16">
					<path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z" />
					<path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466" />
				</svg>
			</a>
		</button>
		
	</div>
</form>

@* Table with all fetched events *@
<table class="table table-striped">
	<tr>
		<th><a asp-action="Index" asp-route-sortOrder="name" style="text-decoration:none;color:inherit;">Name</a></th>
		<th><a asp-action="Index" asp-route-sortOrder="county" style="text-decoration:none;color:inherit;">County</a></th>
		<th><a asp-action="Index" asp-route-sortOrder="state" style="text-decoration:none;color:inherit;">State</a></th>
		<th>Details</th>
	</tr>
	@foreach (var item in Model)
	{
		<tr>
			<td>@item._name</td>
			<td>@item._county</td>
			<td>@item._state</td>
			<td><a asp-action="Details" asp-route-id="@item._id" style="text-decoration:none;color:inherit;">Details</a></td>
			@*<td><a asp-action="Details" asp-route-link="@item._link" style="text-decoration:none;color:inherit;">Details</a></td>*@
		</tr>
	}
</table>