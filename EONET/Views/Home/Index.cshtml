@model List<EONET.Models.EonetData>

@{
	ViewData["Title"] = "Natural Events";
}

<h1 class="mb-4">Natural Events</h1>


@* Table with all fetched events *@
<table class ="table table-striped">
	<tr>
		<th><a asp-action="Index" asp-route-sortOrder="name" style="text-decoration:none;color:inherit;">Name</a></th>
		<th><a asp-action="Index" asp-route-sortOrder="county" style="text-decoration:none;color:inherit;">County</a></th>
		<th><a asp-action="Index" asp-route-sortOrder="state" style="text-decoration:none;color:inherit;">State</a></th>
		<th>Details</th>
	</tr>
	@foreach (var item in Model)
	{
		<tr>
			<td>@item._name</td>
			<td>@item._county</td>
			<td>@item._state</td>
			<td><a asp-action="Details" asp-route-id="@item._id" style="text-decoration:none;color:inherit;">Details</a></td>
			@*<td><a asp-action="Details" asp-route-link="@item._link" style="text-decoration:none;color:inherit;">Details</a></td>*@
		</tr>
	}
</table>