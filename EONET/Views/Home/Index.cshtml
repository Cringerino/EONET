@model List<EONET.Models.Event>

@{
	ViewData["Title"] = "Natural Events";
}

<h1 class="mb-4">Natural Events</h1>


@* Table with all fetched events *@
<table class="table table-striped table-hover align-middle">
	<thead>
		<tr>
			<th>Title</th>
			<th>events</th>
			<th>Link</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>@item.title</td>
				<td><a href="@item.link" target="_blank" rel="noreferrer">Details</a></td>
			</tr>
		}
	</tbody>
</table>
